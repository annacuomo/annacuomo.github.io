---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';
import { highlightMe, url } from '../lib/util';

const sections = (await getCollection('cv')).map((s) => s.data).sort((a, b) => a.order - b.order);
const before = sections.filter((s) => s.order < 10);
const after = sections.filter((s) => s.order >= 10);
const pubs = (await getCollection('publications')).map((p) => p.data).sort((a, b) => b.year - a.year || a.rank - b.rank);
const talks = (await getCollection('talks')).map((t) => t.data).sort((a, b) => b.year - a.year);
const href = (s: string) => (s.startsWith('http') ? s : url(s));
---
<Base title="CV">
  <section style="padding-top:24px">
    <h1>Curriculum Vitae</h1>
    <p class="link-row" style="margin:16px 0 40px">
      {site.links.map((l) => <a class="accent-link" href={l.url}>{l.label}</a>)}
    </p>

    {before.map((s) => (
      <div class="cv-section">
        <h2>{s.heading}</h2>
        {s.items.map((it) => (
          <div class="cv-item">
            <div class="cv-when">{it.when}</div>
            <div>
              <h3>{it.link ? <a href={it.link} style="color:inherit">{it.title}</a> : it.title}</h3>
              {it.where && <div class="muted">{it.where}</div>}
              {it.details && <ul>{it.details.map((d) => <li>{d}</li>)}</ul>}
            </div>
          </div>
        ))}
      </div>
    ))}

    <div class="cv-section">
      <h2>Publications</h2>
      <ul class="pub-list">
        {pubs.map((p) => (
          <li>
            {p.review && <span class="tag tag-review">Review</span>}<a class="title" href={p.url}>{p.title}</a>
            <div class="meta"><span set:html={highlightMe(p.authors)} /> · <em>{p.venue}</em>, {p.year}{p.preprint && <> · <a class="accent-link" href={p.preprint}>Free preprint</a></>}{p.links.map((l) => <> · <a class="accent-link" href={l.url}>{l.label}</a></>)}</div>
          </li>
        ))}
      </ul>
      <p class="muted" style="margin-top:12px">* joint first authors</p>
    </div>

    <div class="cv-section">
      <h2>Talks</h2>
      {talks.map((t) => (
        <div class="cv-item">
          <div class="cv-when">{t.year}</div>
          <div>
            <h3>{t.title}</h3>
            <div class="muted">
              {t.type === 'Invited' ? 'Invited speaker' : t.type === 'Oral' ? 'Oral presentation' : t.type} · {t.location}
              {t.video && <> · <a class="accent-link" href={t.video}>Video</a></>}
              {t.slides && <> · <a class="accent-link" href={href(t.slides)}>Slides</a></>}
            </div>
          </div>
        </div>
      ))}
    </div>

    {after.map((s) => (
      <div class="cv-section">
        <h2>{s.heading}</h2>
        {s.items.map((it) => (
          <div class="cv-item">
            <div class="cv-when">{it.when}</div>
            <div>
              <h3>{it.link ? <a href={it.link} style="color:inherit">{it.title}</a> : it.title}</h3>
              {it.where && <div class="muted">{it.where}</div>}
              {it.details && <ul>{it.details.map((d) => <li>{d}</li>)}</ul>}
            </div>
          </div>
        ))}
      </div>
    ))}
  </section>
</Base>
