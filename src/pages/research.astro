---
// Papers grouped by research topic (topics come from src/data/topics.yaml).
import Base from '../layouts/Base.astro';
import PaperLinks from '../components/PaperLinks.astro';
import { getCollection } from 'astro:content';
import { highlightMe, url } from '../lib/util';

const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const pubs = (await getCollection('publications')).map((p) => p.data).sort((a, b) => b.year - a.year || a.rank - b.rank);
---
<Base title="Research">
  <section style="padding-top:24px">
    <h1 style="margin-bottom:16px">Research</h1>
    <p class="lead" style="max-width:700px;font-size:18px;margin-bottom:40px">
      My work sits where cellular genomics, human genetics and drug discovery meet. Papers are grouped by theme below;
      see <a class="accent-link" href={url('/publications/')}>Publications</a> for the full list by year.
    </p>
    {topics.filter((t) => pubs.some((p) => p.topic === t.id)).map((t) => {
      const list = pubs.filter((p) => p.topic === t.id);
      return (
        <div class={`topic c-${t.data.color}`}>
          <h2>{t.data.title}</h2>
          {t.data.blurb && <p class="blurb">{t.data.blurb}</p>}
          {t.data.image && <img src={url(t.data.image)} alt={`Overview of ${t.data.title}`} />}
          <ul class="pub-list">
            {list.map((p) => (
              <li>
                {p.review && <span class="tag tag-review">Review</span>}<a class="title" href={p.url}>{p.title}</a>
                <div class="meta"><span set:html={highlightMe(p.authors)} /> · <em>{p.venue}</em>, {p.year}</div>
                <PaperLinks preprint={p.preprint} links={p.links} />
              </li>
            ))}
          </ul>
        </div>
      );
    })}
    <p class="muted">* joint first authors · # corresponding authors</p>
  </section>
</Base>
