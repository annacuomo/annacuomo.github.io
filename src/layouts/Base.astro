---
// The frame around every page: <head>, header with menu, footer.
import '../styles/global.css';
import site from '../data/site.json';
import { url } from '../lib/util';

interface Props { title?: string; description?: string; image?: string; math?: boolean }
const { title, description = site.description, image = '/images/social-card.png', math = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.title;
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const nav = [
  { label: 'Home', href: '/' },
  { label: 'Research', href: '/research/' },
  { label: 'Publications', href: '/publications/' },
  { label: 'CV', href: '/cv/' },
  { label: 'Blog', href: '/blog/' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const ogImage = new URL(url(image), Astro.site).toString();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {import.meta.env.BASE_URL !== '/' && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
  {math && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />}
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="site-name" href={url('/')}>{site.name}</a>
      <nav class="site-nav" aria-label="Main">
        {nav.map((n) => (
          <a href={url(n.href)} class={n.href === '/' ? 'nav-home' : undefined} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span class="link-row">
        {site.links.map((l) => <a class="accent-link" href={l.url} data-e={l.e}>{l.label}</a>)}
      </span>
    </div>
  </footer>
  <script is:inline>
    // Builds the email link in the visitor's browser, so the address never appears as plain text in the page
    // (it is stored reversed in src/data/site.json as "e").
    document.querySelectorAll('a[data-e]').forEach(function (a) {
      a.href = 'mailto:' + a.getAttribute('data-e').split('').reverse().join('');
    });
  </script>
</body>
</html>
